# Integration test configuration for @mcp-abap-adt/adt-backup
# Copy this file to tests/test-config.yaml and fill in real values

auth_broker:
  # Connection settings for backup tests
  backup:
    # Destination base directory (contains service-keys/ and sessions/ subfolders)
    # Example (Linux): /home/user/.config/mcp-abap-adt
    # Example (Windows): C:\\Users\\User\\Documents\\mcp-abap-adt
    destination_dir: <BACKUP_DESTINATION_DIR>

    # Optional: explicit .env file path (uses --env flow)
    environment_file: <BACKUP_ENVIRONMENT_FILE>

    # ABAP destination configuration
    abap:
      # Destination name used for service key and session files
      destination: <BACKUP_DESTINATION>

  # Connection settings for verify/restore tests (can point to a different system)
  verify:
    destination_dir: <VERIFY_DESTINATION_DIR>
    environment_file: <VERIFY_ENVIRONMENT_FILE>
    abap:
      destination: <VERIFY_DESTINATION>

  # Connection settings for restore tests (can point to a different system)
  restore:
    destination_dir: <RESTORE_DESTINATION_DIR>
    environment_file: <RESTORE_ENVIRONMENT_FILE>
    abap:
      destination: <RESTORE_DESTINATION>

tests:
  # Group 1: Backup tests
  backup:
    # Output directory for test artifacts
    output_dir: <OUTPUT_DIR>

    # Package backup test
    package:
      name: <PACKAGE_NAME>

    # Single-object backup test (class)
    class:
      name: <CLASS_NAME>

  # Group 2: Restore tests
  restore:
    # Enable restore test
    enabled: false
    # Optional: force restore (use --force)
    force: false

  # Group 3: Verify tests
  verify:
    # Enable verify test
    enabled: false
    # Optional: strict verify (use --strict)
    strict: false
