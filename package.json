{
  "name": "@mcp-abap-adt/adt-backup",
  "version": "3.0.0",
  "description": "ADT backup CLI for SAP ABAP objects (recursive package backups and restores)",
  "main": "dist/bin/adt-backup.js",
  "types": "dist/bin/adt-backup.d.ts",
  "bin": {
    "adt-backup": "dist/bin/adt-backup.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "abap",
    "sap",
    "adt",
    "backup",
    "cli",
    "mcp"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/fr0ster/mcp-abap-adt-backup#readme",
  "bugs": {
    "url": "https://github.com/fr0ster/mcp-abap-adt-backup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt-backup.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "npx biome check --write src",
    "lint:check": "npx biome check src",
    "format": "npx biome format --write src",
    "build": "npm run --silent clean && npx biome check src --diagnostic-level=error && npx tsc -p tsconfig.json && chmod +x dist/bin/adt-backup.js",
    "build:fast": "npx tsc -p tsconfig.json && chmod +x dist/bin/adt-backup.js",
    "test:integration": "node scripts/integration-test.mjs",
    "test:offline": "node tests/offline/messageclass.cjs && node tests/offline/sequences.cjs && node tests/offline/documents.cjs",
    "delete:package": "npx ts-node scripts/delete-package.ts"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "@mcp-abap-adt/adt-clients": "^23.0.2",
    "@mcp-abap-adt/adt-strategies": "^0.6.0",
    "@mcp-abap-adt/auth-broker": "^3.0.1",
    "@mcp-abap-adt/auth-providers": "^4.2.0",
    "@mcp-abap-adt/auth-stores": "^1.2.4",
    "@mcp-abap-adt/connection": "^9.4.0",
    "@mcp-abap-adt/interfaces-adt": "^11.0.0",
    "@mcp-abap-adt/interfaces-adt-connection": "^1.0.0",
    "@mcp-abap-adt/interfaces-auth": "^2.1.0",
    "@mcp-abap-adt/interfaces-auth-sap": "^1.0.1",
    "@mcp-abap-adt/interfaces-utils": "^1.1.0",
    "fast-xml-parser": "^5.7.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
